+/** A question to the lead counts once it has waited this long. */
+const QUESTION_WAIT_S = 600;
+
+/** One label per signal that needs the lead, in a fixed order. */
+export function problemReasons(t: TeamModel): string[] {
+  const s = t.status;
+  const reasons: string[] = [];
+  if (s.state === "open") {
+    const live = livenessInfo(s.lead);
+    if (live.category === "failed" || live.category === "attention") reasons.push(live.label);
+    if (s.watch.state === "stale") reasons.push("watch stale");
+    if (s.afk?.spent === true) reasons.push("AFK spent");
+  }
+  if (s.unread_deliveries.length > 0) reasons.push(`${s.unread_deliveries.length} unread`);
+  const waiting = s.unanswered_questions.filter((q) => q.to.includes("lead") && q.age_s >= QUESTION_WAIT_S).length;
+  if (waiting > 0) reasons.push(`${waiting} question waiting`);
+  return reasons;
+}
