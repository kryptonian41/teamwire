+fn make_fifo(path: &std::path::Path) {
+    let status = std::process::Command::new("mkfifo")
+        .arg(path)
+        .status()
+        .unwrap();
+    assert!(status.success());
+}
+
+#[test]
+fn probe_a_named_pipe_transcript_gives_no_final_message() {
+    let (tx, rx) = std::sync::mpsc::channel();
+    std::thread::spawn(move || {
+        let (mut rig, api) = team();
+        let path = rig.home.path().join("pipe.jsonl");
+        make_fifo(&path);
+        let mut t = stop("api-1");
+        t.final_message = None;
+        t.transcript = Some(path);
+        finish(&mut rig, &api, &t);
+        tx.send((outbox(&rig), rig.newest(&api).completion.final_source))
+            .ok();
+    });
+    let (text, source) = rx
+        .recv_timeout(std::time::Duration::from_secs(10))
+        .expect("the hook blocked on the pipe");
+    assert!(text.contains("Final message from: none"), "{text}");
+    assert_eq!(source, FinalSource::None);
+}
+
+#[test]
+fn probe_a_transcript_past_64_mib_gives_no_final_message() {
+    let (mut rig, api) = team();
+    let path = transcript(&rig, "From a huge file.");
+    let mut f = std::fs::OpenOptions::new()
+        .append(true)
+        .open(&path)
+        .unwrap();
+    std::io::Write::write_all(&mut f, b"\n").unwrap();
+    f.set_len(64 * 1024 * 1024 + 1).unwrap();
+    let mut t = stop("api-1");
+    t.final_message = None;
+    t.transcript = Some(path);
+    finish(&mut rig, &api, &t);
+    let text = outbox(&rig);
+    assert!(text.contains("Final message from: none"), "{text}");
+    assert_eq!(rig.newest(&api).completion.final_source, FinalSource::None);
+}
+
+#[test]
+fn probe_a_transcript_of_exactly_64_mib_is_read() {
+    let (mut rig, api) = team();
+    let path = transcript(&rig, "From a full file.");
+    let mut f = std::fs::OpenOptions::new()
+        .append(true)
+        .open(&path)
+        .unwrap();
+    std::io::Write::write_all(&mut f, b"\n").unwrap();
+    f.set_len(64 * 1024 * 1024).unwrap();
+    let mut t = stop("api-1");
+    t.final_message = None;
+    t.transcript = Some(path);
+    finish(&mut rig, &api, &t);
+    assert!(outbox(&rig).contains("From a full file."));
+    assert_eq!(
+        rig.newest(&api).completion.final_source,
+        FinalSource::Transcript
+    );
+}
