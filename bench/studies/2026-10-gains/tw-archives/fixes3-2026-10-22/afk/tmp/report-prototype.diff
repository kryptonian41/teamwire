+/// The bytes of the transcript file at `path` and their length, or `None`
+/// when it is not a regular file, cannot be read, or would bring `used` bytes
+/// already read past `MAX_TRANSCRIPT_BYTES`. Only a regular file is opened:
+/// opening a FIFO would block the Stop hook.
+pub(crate) fn read_transcript(path: &Path, used: u64) -> Option<(u64, Vec<u8>)> {
+    std::fs::metadata(path)
+        .ok()
+        .filter(|m| m.is_file() && used.saturating_add(m.len()) <= MAX_TRANSCRIPT_BYTES)
+        .and_then(|m| Some((m.len(), std::fs::read(path).ok()?)))
+}
