+/// Beta holds its own copy of m001 from an earlier attempt, with db's row
+/// left in `state` (pending, handed off or read).
+fn copy_in_beta(t: &mut Two, ulid: Ulid, body: &str, state: DeliveryState) {
+    let at = t.rig.now();
+    t.beta
+        .write(|tx| {
+            tx.insert_received(
+                at,
+                &ReceivedMessage {
+                    ulid,
+                    sender: Remote::member_of(&TeamName::parse("alpha").unwrap(), &role("api")),
+                    kind: MessageType::Finding,
+                    re: None,
+                    commit: None,
+                    body: body.to_owned(),
+                    recipients: vec![Recipient::Member(role("db"))],
+                },
+            )?;
+            match state {
+                DeliveryState::Pending => Ok(()),
+                DeliveryState::Acked => tx.ack_delivery(at, &ulid, &to("db")).map(|_| ()),
+                other @ (DeliveryState::HandedOff
+                | DeliveryState::Unconfirmed
+                | DeliveryState::Undelivered) => tx.set_delivery_state(
+                    at,
+                    &ulid,
+                    &to("db"),
+                    &teamwire_store::DeliveryUpdate {
+                        state: other,
+                        route: Some(teamwire_core::Route::HostTyping),
+                        error: None,
+                        attempts: 1,
+                    },
+                ),
+            }
+        })
+        .unwrap();
+}
+
+fn close_beta(t: &mut Two, finish: bool) {
+    let pid = teamwire_core::Pid::new(4242);
+    let at = t.rig.now();
+    t.beta.write(|tx| tx.begin_close(at, pid)).unwrap();
+    if finish {
+        t.beta
+            .write(|tx| tx.finish_close(at, &teamwire_store::CloseEnd::Completed))
+            .unwrap();
+    }
+}
