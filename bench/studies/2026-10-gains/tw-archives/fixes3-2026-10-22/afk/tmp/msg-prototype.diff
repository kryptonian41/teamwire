+#[test]
+fn probe_closing_team_handed_off_copy() {
+    let (r, here, typed) = probe(DeliveryState::HandedOff, false);
+    assert_eq!(
+        (r.state, r.reason, here, typed),
+        (RecipientState::HandedOff, None, DeliveryState::HandedOff, 0)
+    );
+}
+
+#[test]
+fn probe_closed_team_read_copy() {
+    let (r, here, typed) = probe(DeliveryState::Acked, true);
+    assert_eq!(
+        (r.state, r.reason, here, typed),
+        (RecipientState::HandedOff, None, DeliveryState::HandedOff, 0)
+    );
+}
+
+#[test]
+fn probe_closing_team_pending_copy() {
+    let (r, here, typed) = probe(DeliveryState::Pending, false);
+    assert_eq!(
+        (r.state, r.reason, here, typed),
+        (
+            RecipientState::Unconfirmed,
+            Some(DeliveryErrorCode::TeamClosed),
+            DeliveryState::Unconfirmed,
+            0
+        )
+    );
