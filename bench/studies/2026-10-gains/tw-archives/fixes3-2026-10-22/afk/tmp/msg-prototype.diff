+/// What a team that is closing or closed already holds for one recipient,
+/// from an earlier attempt. Nothing can be typed there now. A row that
+/// arrived keeps that outcome; one that may have arrived is unconfirmed; and
+/// a missing copy, or a row that surely never arrived, is `gone`.
+fn held_there(
+    there: &Ctx<'_>,
+    team: &TeamName,
+    message: &Message,
+    t: &Try<'_>,
+) -> Result<Outcome, SendError> {
+    let local = remote_of(&t.row.delivery.recipient)
+        .map(Remote::local)
+        .ok_or_else(|| SendError::Internal("a local row reached the remote path".to_owned()))?;
+    let row = there.store.read(|tx| tx.delivery(&message.ulid, &local))?;
+    Ok(match row {
+        Some(r)
+            if matches!(
+                r.delivery.state,
+                DeliveryState::HandedOff | DeliveryState::Acked
+            ) =>
+        {
+            outcome_of(&r)
+        }
+        Some(r)
+            if matches!(
+                r.delivery.state,
+                DeliveryState::Pending | DeliveryState::Unconfirmed
+            ) =>
+        {
+            Outcome {
+                state: DeliveryState::Unconfirmed,
+                route: r.delivery.route,
+                error: Some(DeliveryError::new(
+                    DeliveryErrorCode::TeamClosed,
+                    format!(
+                        "team {team} is closing or closed; an earlier attempt may have reached it"
+                    ),
+                )),
+            }
+        }
+        Some(_) | None => gone(team),
+    })
+}
