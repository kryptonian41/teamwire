@@ -0,0 +1,30 @@
+//! `teamwire afk start`: creates an AFK run's team, copies the task into it
+//! and takes the sleep hold (`docs/design/2026-10-19-afk-mode.md` 5.2).
+
+use std::process::ExitCode;
+
+use crate::wiring::Wiring;
+use crate::{AfkArgs, AfkCommand, AfkStartArgs, Global};
+
+/// Refused by a rule; nothing changed (docs/api/cli.md).
+const REFUSED: u8 = 1;
+
+/// The arguments are the agreed command line; the body refuses until the
+/// command is built.
+#[expect(
+    clippy::print_stderr,
+    reason = "the binary reports a refusal on stderr"
+)]
+pub(crate) fn run(args: &AfkArgs, _global: &Global, _wiring: &Wiring) -> ExitCode {
+    let AfkCommand::Start(AfkStartArgs {
+        team,
+        title,
+        task,
+        budget,
+    }) = &args.command;
+    eprintln!(
+        "teamwire afk start: not built yet (team {team}, title {title:?}, task {}, budget {budget})",
+        task.display()
+    );
+    ExitCode::from(REFUSED)
+}
