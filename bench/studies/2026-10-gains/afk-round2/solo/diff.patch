index 0000000..caff29e
--- /dev/null
+++ b/crates/teamwire-launch/tests/afk.rs
@@ -0,0 +1,266 @@
+//! AFK runs: `validate_afk` and `start_afk` behind `teamwire afk start`, and
+//! the budget refusal and model-table warnings of a launch into an AFK team.
+#![expect(
+    clippy::unwrap_used,
+    clippy::redundant_closure_for_method_calls,
+    reason = "helpers in an integration test unwrap, and `ReadTx` method paths do not infer the transaction's lifetime"
+)]
+
+#[cfg(test)]
+#[path = "support/common.rs"]
+#[expect(
+    dead_code,
+    reason = "each test binary uses a different part of the shared helpers"
+)]
+mod common;
+
+use std::time::Duration;
+
+use common::{Rig, codes, lead_at, pane_member, team_hold, team_spec, with};
+use serde_json::json;
+use teamwire_core::{Clock, HarnessId, HoldInfo};
+use teamwire_fakes::FakeHarness;
+use teamwire_launch::{
+    AfkRequest, AfkStarted, SpecError, check_lead_process, start_afk, validate_afk,
+};
+use teamwire_store::{Ctx, Store};
+
+fn request(team: &str) -> AfkRequest {
+    AfkRequest {
+        team: team.to_owned(),
+        title: "Contributing guide".to_owned(),
+        budget: Duration::from_secs(8 * 3600),
+    }
+}
+
+/// `validate_afk`, then the lead-process check, as the CLI runs them.
+fn check(rig: &Rig, team: &str) -> Result<teamwire_launch::AfkPlan, Vec<SpecError>> {
+    let plan = validate_afk(&request(team), &rig.env())?;
+    check_lead_process(&rig.env(), &plan).map_err(|e| vec![e])?;
+    Ok(plan)
+}
+
+/// Checks and starts an AFK team, as the CLI does.
+fn start(rig: &Rig, team: &str) -> (AfkStarted, Store) {
+    let plan = check(rig, team).unwrap();
+    let mut store = Store::open(rig.home.path(), &plan.team).unwrap();
+    let started = {
+        let mut ctx = Ctx {
+            home: rig.home.path(),
+            store: &mut store,
+            registry: &rig.registry,
+            platform: &*rig.platform,
+            clock: &rig.clock as &dyn Clock,
+            config: &rig.config,
+        };
+        start_afk(&mut ctx, &plan, b"Add a CONTRIBUTING.md.\n\xff raw bytes").unwrap()
+    };
+    (started, store)
+}
+
+#[expect(
+    clippy::redundant_closure_for_method_calls,
+    reason = "`ReadTx::team` as a path does not infer the transaction's lifetime for `Store::read`"
+)]
+fn team_row(store: &Store) -> teamwire_store::TeamRow {
+    store.read(|tx| tx.team()).unwrap().unwrap()
+}
+
+#[test]
+fn a_start_creates_an_empty_afk_team_with_the_task_and_the_hold() {
+    let rig = Rig::new();
+    lead_at(&rig, 4242);
+    rig.harness.set_session_cwd(
+        teamwire_core::SessionId::parse("lead-session").unwrap(),
+        "/work/repo",
+    );
+    let (started, store) = start(&rig, "afkrun");
+    let row = team_row(&store);
+    assert_eq!(
+        row.afk_budget_ends_at,
+        rig.clock.now().checked_add(Duration::from_secs(8 * 3600))
+    );
+    assert_eq!(row.title, "Contributing guide");
+    assert!(store.read(|tx| tx.members()).unwrap().items.is_empty());
+    assert_eq!(
+        std::fs::read(started.afk_dir.join("task.md")).unwrap(),
+        b"Add a CONTRIBUTING.md.\n\xff raw bytes"
+    );
+    assert_eq!(
+        started.afk_dir,
+        rig.home.path().join("teams").join("afkrun").join("afk")
+    );
+    let held: Option<HoldInfo> = team_hold(&store);
+    assert!(held.is_some_and(|h| h.owned), "{held:?}");
+    assert!(started.warnings.is_empty(), "{:?}", started.warnings);
+    let created = store
+        .read(|tx| tx.events_of_type(teamwire_core::EventType::TeamCreated))
+        .unwrap()
+        .items;
+    let data = &created.first().unwrap().data;
+    assert_eq!(data["lead_cwd"], "/work/repo");
+    assert!(data["afk_budget_ends_at"].is_string());
+}
+
+#[test]
+fn no_lead_session_is_refused() {
+    let rig = Rig::new();
+    rig.harness.set_caller(None);
+    assert_eq!(
+        codes(&check(&rig, "afkrun").unwrap_err()),
+        ["no_lead_session"]
+    );
+    assert!(rig.home_is_empty());
+}
+
+#[test]
+fn a_lead_whose_process_cannot_be_found_is_refused_when_a_hold_is_needed() {
+    let rig = Rig::new();
+    assert_eq!(
+        codes(&check(&rig, "afkrun").unwrap_err()),
+        ["no_lead_process"]
+    );
+    assert!(rig.home_is_empty());
+}
+
+#[test]
+fn a_platform_without_a_sleep_hold_needs_no_lead_process() {
+    let rig = Rig::without_hold();
+    let (started, store) = start(&rig, "afkrun");
+    assert_eq!(team_hold(&store), None);
+    assert!(
+        started.warnings.iter().any(|w| w.contains("no sleep hold")),
+        "{:?}",
+        started.warnings
+    );
+}
+
+#[test]
+fn a_second_afk_run_from_the_same_session_is_refused() {
+    let rig = Rig::new();
+    lead_at(&rig, 4242);
+    let _first = start(&rig, "afkrun");
+    assert_eq!(
+        codes(&check(&rig, "another").unwrap_err()),
+        ["afk_already_running"]
+    );
+}
+
+#[test]
+fn name_title_and_taken_name_use_launchs_rules() {
+    let rig = Rig::new();
+    lead_at(&rig, 4242);
+    let bad = AfkRequest {
+        team: "Bad-Name".to_owned(),
+        title: "x".repeat(40),
+        budget: Duration::from_secs(60),
+    };
+    assert_eq!(
+        codes(&validate_afk(&bad, &rig.env()).unwrap_err()),
+        ["bad_name", "title_too_long"]
+    );
+    common::seed_team(&rig, "taken", |_, _| Ok(()));
+    assert_eq!(codes(&check(&rig, "taken").unwrap_err()), ["team_exists"]);
+}
+
+#[test]
+fn add_accepts_an_afk_team_with_no_members_yet() {
+    let rig = Rig::new();
+    lead_at(&rig, 4242);
+    let _afk = start(&rig, "afkrun");
+    let spec = team_spec("afkrun", &[pane_member("scout", "Scout", rig.work.path())]);
+    let plan = rig.validate(&spec, true).unwrap();
+    let (report, _) = rig.launch("afkrun", plan);
+    assert!(
+        matches!(
+            report.members.first().unwrap().outcome,
+            teamwire_launch::LaunchOutcome::Started
+        ),
+        "{report:?}"
+    );
+}
+
+fn investigator(rig: &Rig, role: &str) -> serde_json::Value {
+    with(
+        pane_member(role, role, rig.work.path()),
+        "kind",
+        json!("investigator"),
+    )
+}
+
+#[test]
+fn past_the_budget_an_implementer_is_refused_and_other_kinds_are_not() {
+    let rig = Rig::new();
+    lead_at(&rig, 4242);
+    let _afk = start(&rig, "afkrun");
+    rig.clock.advance(Duration::from_secs(9 * 3600));
+    let repo = rig.repo("proj");
+    let spec = team_spec(
+        "afkrun",
+        &[
+            common::worktree_member("api", "Api", &repo),
+            investigator(&rig, "reporter"),
+        ],
+    );
+    let errors = rig.validate(&spec, true).unwrap_err();
+    assert_eq!(codes(&errors), ["afk_budget_spent"]);
+    assert_eq!(errors.first().unwrap().role.as_deref(), Some("api"));
+
+    let spec = team_spec("afkrun", &[investigator(&rig, "reporter")]);
+    assert!(rig.validate(&spec, true).is_ok());
+}
+
+#[test]
+fn inside_the_budget_an_implementer_is_accepted() {
+    let rig = Rig::new();
+    lead_at(&rig, 4242);
+    let _afk = start(&rig, "afkrun");
+    let repo = rig.repo("proj");
+    let spec = team_spec("afkrun", &[common::worktree_member("api", "Api", &repo)]);
+    assert!(rig.validate(&spec, true).is_ok());
+}
+
+#[test]
+fn an_ordinary_team_has_no_budget() {
+    let rig = Rig::new();
+    lead_at(&rig, 4242);
+    common::launch_one(&rig, "plain", "a", false);
+    rig.clock.advance(Duration::from_secs(1_000_000));
+    let repo = rig.repo("proj");
+    let spec = team_spec("plain", &[common::worktree_member("api", "Api", &repo)]);
+    assert!(rig.validate(&spec, true).is_ok());
+}
+
+#[test]
+fn the_model_table_warns_only_about_claude_members_below_it() {
+    let mut rig = Rig::new();
+    rig.registry
+        .add_harness(std::sync::Arc::new(FakeHarness::with_id(
+            HarnessId::from_static("claude-code"),
+        )))
+        .unwrap();
+    lead_at(&rig, 4242);
+    let _afk = start(&rig, "afkrun");
+    let claude = |role: &str, kind: &str, model: &str, effort: &str| {
+        json!({"role": role, "title": role, "mode": "pane", "cwd": rig.work.path(),
+               "task": "t", "kind": kind, "harness": "claude-code",
+               "model": model, "effort": effort})
+    };
+    let spec = team_spec(
+        "afkrun",
+        &[
+            claude("good", "reviewer", "opus", "xhigh"),
+            claude("low", "reviewer", "opus", "high"),
+            claude("cheap", "investigator", "sonnet", "max"),
+            pane_member("fake", "Fake", rig.work.path()),
+        ],
+    );
+    let warnings = rig.validate(&spec, true).unwrap().warnings;
+    let afk: Vec<&String> = warnings
+        .iter()
+        .filter(|w| w.contains("below the AFK table"))
+        .collect();
+    assert_eq!(afk.len(), 2, "{warnings:?}");
+    assert!(afk.iter().any(|w| w.starts_with("member low:")));
+    assert!(afk.iter().any(|w| w.starts_with("member cheap:")));
+}
