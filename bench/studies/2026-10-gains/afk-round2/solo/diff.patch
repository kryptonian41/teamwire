diff --git a/crates/teamwire-launch/src/afk.rs b/crates/teamwire-launch/src/afk.rs
new file mode 100644
index 0000000..6ac31c2
--- /dev/null
+++ b/crates/teamwire-launch/src/afk.rs
@@ -0,0 +1,264 @@
+//! AFK runs (ADR 0025): `teamwire afk start` creates a team with no members
+//! and a wall-clock budget, and takes the sleep hold at once. Launch then
+//! refuses new implementers past the budget, and warns about members below
+//! the AFK model table.
+
+use std::path::PathBuf;
+use std::time::Duration;
+
+use serde_json::json;
+use teamwire_core::{HarnessId, MemberKind, SessionKind, TeamName, TeamState, Timestamp};
+use teamwire_store::{Ctx, NewTeam, Store, team_names};
+
+use crate::validate::{Existing, title_error};
+use crate::{LeadPlan, PlannedMember, SpecError, ValidateEnv, hold};
+
+/// What `teamwire afk start` asks for.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct AfkRequest {
+    /// The team name as typed; checked here with launch's rules.
+    pub team: String,
+    pub title: String,
+    pub budget: Duration,
+}
+
+/// An AFK start that passed every check, ready to create.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct AfkPlan {
+    pub team: TeamName,
+    pub title: String,
+    pub lead: LeadPlan,
+    pub budget_ends_at: Timestamp,
+}
+
+/// What `start_afk` made.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct AfkStarted {
+    /// `<home>/teams/<team>/afk`.
+    pub afk_dir: PathBuf,
+    /// Problems that did not stop the start, such as a hold that failed.
+    pub warnings: Vec<String>,
+}
+
+/// Steps 1 and 2 of the start: reads only, and creates nothing. Each refusal
+/// carries the code the CLI prints.
+pub fn validate_afk(req: &AfkRequest, env: &ValidateEnv<'_>) -> Result<AfkPlan, Vec<SpecError>> {
+    let one = |code: &str, field: Option<&str>, message: String| {
+        vec![SpecError::new(None, field, code, message)]
+    };
+    let harness = env
+        .registry
+        .harness(&env.lead_harness)
+        .map_err(|e| one("unknown_harness", None, e.to_string()))?;
+    let Some(session) = harness.current_session() else {
+        return Err(one(
+            "no_lead_session",
+            None,
+            "no lead session id reached this command; run it from the lead's Claude Code session"
+                .to_owned(),
+        ));
+    };
+    if session.kind == SessionKind::Background {
+        return Err(one(
+            "background_lead",
+            None,
+            "this session runs in the background and has no terminal of its own; start the AFK \
+             run from a session in a terminal"
+                .to_owned(),
+        ));
+    }
+    if let Some(open) = open_afk_team_of(env, &session.id) {
+        return Err(one(
+            "afk_already_running",
+            Some("team"),
+            format!("this session already leads the open AFK team {open}; close it first"),
+        ));
+    }
+    let mut errors = Vec::new();
+    let team = match TeamName::parse(&req.team) {
+        Ok(team) => Some(team),
+        Err(e) => {
+            errors.push(SpecError::new(
+                None,
+                Some("team"),
+                "bad_name",
+                e.to_string(),
+            ));
+            None
+        }
+    };
+    let title = crate::plan::clean(&req.title);
+    errors.extend(title_error(&title));
+    if let Some(team) = &team
+        && teamwire_store::database_path(env.home, team).is_file()
+    {
+        errors.push(SpecError::new(
+            None,
+            Some("team"),
+            "team_exists",
+            format!("team {team} already exists; pick another name"),
+        ));
+    }
+    let route = crate::validate::lead_plan(env, None, Some((session.id.clone(), session.kind)))
+        .map_err(|e| vec![e])?;
+    crate::validate::lead_must_be_locatable(env, &route, &mut errors);
+    let (Some(team), true) = (team, errors.is_empty()) else {
+        return Err(errors);
+    };
+    let budget_ends_at = env.clock.now().checked_add(req.budget).ok_or_else(|| {
+        one(
+            "bad_budget",
+            Some("budget"),
+            "the budget is too long".to_owned(),
+        )
+    })?;
+    Ok(AfkPlan {
+        team,
+        title,
+        lead: route,
+        budget_ends_at,
+    })
+}
+
+/// Refuses with `no_lead_process` when the platform needs a sleep hold and
+/// the lead's process cannot be found. Run it before anything is created.
+pub fn check_lead_process(env: &ValidateEnv<'_>, plan: &AfkPlan) -> Result<(), SpecError> {
+    let (Some((session, _)), Some(_)) = (&plan.lead.session, env.platform.sleep_hold()) else {
+        return Ok(());
+    };
+    let mut why = Vec::new();
+    if hold::lead_process(env.registry, &plan.lead.harness, session, &mut why).is_some() {
+        return Ok(());
+    }
+    Err(SpecError::new(
+        None,
+        None,
+        "no_lead_process",
+        format!(
+            "the sleep hold needs the lead's process, and it was not found: {}",
+            why.join("; ")
+        ),
+    ))
+}
+
+/// The open AFK team `session` leads, if any. A team that cannot be read is
+/// not counted.
+#[expect(
+    clippy::redundant_closure_for_method_calls,
+    reason = "`ReadTx::team` as a path does not infer the transaction's lifetime for `Store::read`"
+)]
+fn open_afk_team_of(env: &ValidateEnv<'_>, session: &teamwire_core::SessionId) -> Option<TeamName> {
+    team_names(env.home).ok()?.into_iter().find(|name| {
+        Store::open_read_only(env.home, name)
+            .ok()
+            .and_then(|store| store.read(|tx| tx.team()).ok().flatten())
+            .is_some_and(|t| {
+                t.state == TeamState::Open
+                    && t.afk_budget_ends_at.is_some()
+                    && t.lead_session.as_ref() == Some(session)
+            })
+    })
+}
+
+/// Steps 4 to 6: creates the team with no members, copies the task to
+/// `afk/task.md` byte for byte, and starts or reuses the sleep hold. `ctx`'s
+/// store is the new team's, opened by the caller.
+pub fn start_afk(ctx: &mut Ctx<'_>, plan: &AfkPlan, task: &[u8]) -> Result<AfkStarted, String> {
+    let at = ctx.clock.now();
+    let team = NewTeam {
+        name: plan.team.clone(),
+        title: plan.title.clone(),
+        lead_harness: plan.lead.harness.clone(),
+        lead_host: plan.lead.host.clone(),
+        lead_route: plan.lead.route,
+        lead_session: plan.lead.session.clone(),
+    };
+    let cwd = crate::member::lead_cwd(ctx, &plan.lead);
+    let extra = cwd.map_or(json!({}), |cwd| json!({ "lead_cwd": cwd }));
+    ctx.store
+        .write(|tx| {
+            tx.create_afk_team(at, &team, plan.budget_ends_at, &extra)
+                .map(|_| ())
+        })
+        .map_err(|e| format!("the team could not be recorded: {e}"))?;
+    let afk_dir = ctx.home.join("teams").join(plan.team.as_str()).join("afk");
+    let mut warnings = Vec::new();
+    let copied = std::fs::create_dir_all(&afk_dir)
+        .map_err(|e| e.to_string())
+        .and_then(|()| {
+            ctx.platform
+                .write_atomic(&afk_dir.join("task.md"), task)
+                .map_err(|e| e.to_string())
+        });
+    if let Err(e) = copied {
+        // The team exists now; the lead can write the task file itself.
+        warnings.push(format!(
+            "the task could not be copied to {}: {e}",
+            afk_dir.join("task.md").display()
+        ));
+    }
+    let lead = (
+        &plan.lead.harness,
+        plan.lead.session.as_ref().map(|(s, _)| s),
+    );
+    hold::ensure_hold(ctx, &plan.team, lead, &mut warnings);
+    Ok(AfkStarted { afk_dir, warnings })
+}
+
+/// The least effort the AFK table gives each kind (design section 6).
+fn least_effort(kind: MemberKind) -> &'static str {
+    match kind {
+        MemberKind::Implementer | MemberKind::Investigator => "high",
+        MemberKind::Reviewer | MemberKind::Closer => "xhigh",
+    }
+}
+
+fn effort_rank(effort: &str) -> usize {
+    ["low", "medium", "high", "xhigh", "max"]
+        .iter()
+        .position(|e| *e == effort)
+        .unwrap_or(0)
+}
+
+/// The budget refusal and the model-table warnings for a launch into an
+/// AFK team. A team without a budget is unaffected.
+pub(crate) fn check_members(
+    env: &ValidateEnv<'_>,
+    existing: Option<&Existing>,
+    members: &[PlannedMember],
+    errors: &mut Vec<SpecError>,
+    warnings: &mut Vec<String>,
+) {
+    let Some(ends) = existing.and_then(|e| e.team.afk_budget_ends_at) else {
+        return;
+    };
+    let spent = env.clock.now() >= ends;
+    let claude = HarnessId::from_static("claude-code");
+    for m in members {
+        let role = m.spec.role.as_str();
+        if spent && m.kind == MemberKind::Implementer {
+            errors.push(SpecError::new(
+                Some(role),
+                Some("kind"),
+                "afk_budget_spent",
+                format!(
+                    "the AFK budget was spent at {ends}; no new implementer may start. Finish \
+                     what is running, verify it, and have the reporter list the rest as not done"
+                ),
+            ));
+        }
+        if m.harness != claude {
+            continue;
+        }
+        let model = m.spec.model.as_deref().unwrap_or("the default");
+        let effort = m.spec.effort.as_deref().unwrap_or("the default");
+        let least = least_effort(m.kind);
+        if !model.to_lowercase().contains("opus") || effort_rank(effort) < effort_rank(least) {
+            warnings.push(format!(
+                "member {role}: model {model} at effort {effort} is below the AFK table, which \
+                 gives a {} opus at {least} or more",
+                m.kind
+            ));
+        }
+    }
+}
