+//! AFK runs through the real binary: the refusals of `teamwire afk start`,
+//! the AFK line of `status`, the `afk_budget_ends_at` key of `teams --json`,
+//! and the AFK hold of the lead's Stop hook.
+#![expect(
+    clippy::disallowed_methods,
+    reason = "the test starts the teamwire binary and writes fixture files"
+)]
+#![expect(
+    clippy::unwrap_used,
+    clippy::indexing_slicing,
+    reason = "helper functions in an integration-test file unwrap and index JSON; a failure there fails the test"
+)]
+
+#[path = "../../teamwire-verify/tests/support/fixture.rs"]
+pub mod fixture;
+
+use std::io::Write;
+use std::path::Path;
+use std::process::{Command, Stdio};
+
+use fixture::{Fixture, MemberSetup};
+use teamwire_core::{Clock, MemberKind, Mode, SessionId, SessionKind};
+
+struct Run {
+    code: i32,
+    out: String,
+    err: String,
+}
+
+fn teamwire(home: &Path, args: &[&str], env: &[(&str, &str)], stdin: &str) -> Run {
+    let mut cmd = Command::new(env!("CARGO_BIN_EXE_teamwire"));
+    cmd.arg("--home")
+        .arg(home)
+        .args(args)
+        .env_clear()
+        .env("PATH", "/usr/bin:/bin")
+        .env("TEAMWIRE_CLAUDE_DIR", home.join("claude"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped());
+    for (k, v) in env {
+        cmd.env(k, v);
+    }
+    let mut child = cmd.spawn().unwrap();
+    child
+        .stdin
+        .take()
+        .unwrap()
+        .write_all(stdin.as_bytes())
+        .unwrap();
+    let out = child.wait_with_output().unwrap();
+    Run {
+        code: out.status.code().unwrap(),
+        out: String::from_utf8(out.stdout).unwrap(),
+        err: String::from_utf8(out.stderr).unwrap(),
+    }
+}
+
+fn task_file(dir: &Path) -> String {
+    let path = dir.join("task.txt");
+    std::fs::write(&path, "Add a CONTRIBUTING.md.\n").unwrap();
+    path.display().to_string()
+}
+
+fn start(home: &Path, team: &str, env: &[(&str, &str)]) -> Run {
+    let task = task_file(home);
+    teamwire(
+        home,
+        &[
+            "afk", "start", "--team", team, "--title", "Guide", "--task", &task,
+        ],
+        env,
+        "",
+    )
+}
+
+fn nothing_created(home: &Path) -> bool {
+    !home.join("teams").exists()
+}
+
+#[test]
+fn start_outside_a_lead_session_is_refused() {
+    let home = tempfile::tempdir().unwrap();
+    let run = start(home.path(), "afkrun", &[]);
+    assert_eq!(run.code, 1, "{}", run.err);
+    assert!(
+        run.err.contains("refused: no_lead_session: "),
+        "{}",
+        run.err
+    );
+    assert!(run.err.contains("nothing was created"));
+    assert!(nothing_created(home.path()));
+}
+
+#[test]
+fn a_bad_name_is_refused_with_launchs_code() {
+    let home = tempfile::tempdir().unwrap();
+    let run = start(
+        home.path(),
+        "Bad-Name",
+        &[("CLAUDE_CODE_SESSION_ID", "lead-1")],
+    );
+    assert_eq!(run.code, 1, "{}", run.err);
+    assert!(run.err.contains("refused: bad_name: "), "{}", run.err);
+    assert!(nothing_created(home.path()));
+}
+
+#[test]
+fn a_failing_doctor_check_is_refused_and_named() {
+    let home = tempfile::tempdir().unwrap();
+    // No herdr pane, no tmux and no claude on PATH: the host check fails.
+    let run = start(
+        home.path(),
+        "afkrun",
+        &[("CLAUDE_CODE_SESSION_ID", "lead-1")],
+    );
+    assert_eq!(run.code, 1, "{}", run.err);
+    assert!(
+        run.err.contains("refused: doctor_failed: host: "),
+        "{}",
+        run.err
+    );
+    assert!(nothing_created(home.path()));
+}
+
+#[test]
+fn a_zero_budget_is_refused() {
+    let home = tempfile::tempdir().unwrap();
+    let task = task_file(home.path());
+    let run = teamwire(
+        home.path(),
+        &[
+            "afk", "start", "--team", "afkrun", "--title", "Guide", "--task", &task, "--budget",
+            "0h",
+        ],
+        &[("CLAUDE_CODE_SESSION_ID", "lead-1")],
+        "",
+    );
+    assert_eq!(run.code, 1, "{}", run.err);
+    assert!(run.err.contains("refused: bad_budget: "), "{}", run.err);
+}
+
+/// Team `alpha` led from `lead-1`, an AFK run whose budget ends `hours`
+/// from now (negative: already spent), with member `api` started.
+fn afk_team(hours: i64) -> Fixture {
+    let mut fx = Fixture::new();
