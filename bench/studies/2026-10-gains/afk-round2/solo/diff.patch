+/// The AFK hold notes (ADR 0025): one per open AFK team that `session`
+/// leads, when nothing will wake the lead. Something will wake it when an
+/// open team it leads has a working member and a live watch lease. A team
+/// that cannot be read is left out and logged, as in `teams_without_watch`.
+pub fn afk_hold_notes(
+    home: &Path,
+    session: &SessionId,
+    platform: &dyn Platform,
+    clock: &dyn Clock,
+) -> Vec<String> {
+    let names = team_names(home).unwrap_or_else(|e| {
+        tracing::warn!(error = %e, "the teams could not be listed");
+        Vec::new()
+    });
+    let mut afk = Vec::new();
+    for name in names {
+        match led_team(home, &name, session, platform, clock) {
+            Ok(Some(team)) if team.working && team.live_lease => return Vec::new(),
+            Ok(Some(LedTeam {
+                afk_budget_ends_at: Some(ends),
+                ..
+            })) => afk.push((name, ends)),
+            Ok(_) => {}
+            Err(e) => {
+                tracing::warn!(team = %name, error = %e, "a team is left out of the AFK check");
+            }
+        }
+    }
+    let now = clock.now();
+    afk.iter()
+        .map(|(team, ends)| afk_note(home, team, *ends, now))
+        .collect()
+}
+
+fn afk_note(home: &Path, team: &TeamName, ends: Timestamp, now: Timestamp) -> String {
+    let dir = home.join("teams").join(team.as_str());
+    let dir = dir.display();
+    if now >= ends {
+        format!(
+            "[teamwire:{team}] budget spent at {ends}: AFK run, and launch now refuses new implementers. \
+             Finish what is running, then add the reporter, and run `teamwire close {team}` once \
+             {dir}/afk/REPORT.md exists. Nobody will answer you: decide anything open yourself and \
+             add it to {dir}/afk/decisions.md. If a command you started will wake you, stop again."
+        )
+    } else {
+        format!(
+            "[teamwire:{team}] AFK run: nobody will answer you. If you were about to ask the user, \
+             decide it yourself, add it to {dir}/afk/decisions.md, and carry on. If the work is \
+             finished, add the reporter, then run `teamwire close {team}` once {dir}/afk/REPORT.md \
+             exists. If a command you started will wake you, stop again."
+        )
+    }
+}
