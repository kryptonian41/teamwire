+//! `status` of an AFK run: the budget end, the time left and the number of
+//! `D<n>` entries in `afk/decisions.md`. An ordinary team has no `afk`.
+
+#![expect(
+    clippy::unwrap_used,
+    reason = "integration tests unwrap; a failure fails the test"
+)]
+#![expect(
+    clippy::disallowed_methods,
+    reason = "the test stands in for the lead that writes the decision log"
+)]
+
+#[path = "support/fixture.rs"]
+pub mod fixture;
+
+use std::time::Duration;
+
+use fixture::Bed;
+use teamwire_core::Clock as _;
+use teamwire_store::{Ctx, Store};
+use teamwire_watch::StatusView;
+
+fn status_of(bed: &Bed) -> StatusView {
+    let mut store = Store::open_read_only(bed.home.path(), &"alpha".parse().unwrap()).unwrap();
+    let ctx = Ctx {
+        home: bed.home.path(),
+        store: &mut store,
+        registry: &bed.registry,
+        platform: &bed.platform,
+        clock: &bed.clock,
+        config: &bed.config,
+    };
+    teamwire_watch::status_with(&ctx, None)
+}
+
+/// An AFK team whose budget ends two hours from the fake clock's start.
+fn afk_bed() -> Bed {
+    let mut bed = Bed::new();
+    let ends = bed
+        .clock
+        .now()
+        .checked_add(Duration::from_secs(7200))
+        .unwrap();
+    bed.store
+        .write(|tx| {
+            tx.connection()
+                .execute(
+                    "UPDATE team SET afk_budget_ends_at = ?1",
+                    [ends.to_string()],
+                )
+                .map(|_| ())
+                .map_err(Into::into)
+        })
+        .unwrap();
+    bed
+}
+
+#[test]
+fn an_ordinary_team_has_no_afk_view() {
+    assert_eq!(status_of(&Bed::new()).afk, None);
+}
+
+#[test]
+fn an_afk_team_with_no_log_shows_its_budget_and_no_decisions() {
+    let bed = afk_bed();
+    let afk = status_of(&bed).afk.unwrap();
+    assert_eq!(afk.seconds_left, 7200);
+    assert!(!afk.spent);
+    assert_eq!(afk.decisions, 0);
+    assert_eq!(
+        afk.budget_ends_at,
+        bed.clock
+            .now()
+            .checked_add(Duration::from_secs(7200))
+            .unwrap()
+    );
+}
+
+#[test]
+fn only_lines_that_open_an_entry_count_as_decisions() {
+    let bed = afk_bed();
+    let dir = bed.home.path().join("teams").join("alpha").join("afk");
+    std::fs::create_dir_all(&dir).unwrap();
+    std::fs::write(
+        dir.join("decisions.md"),
+        "D1  2026-10-19 14:05  Roster\nChose: three members.\n\
+         D2  2026-10-19 14:10  Which column?\nDecided later: no.\nD12\nDx not one\n",
+    )
+    .unwrap();
+    assert_eq!(status_of(&bed).afk.unwrap().decisions, 3);
+}
+
+#[test]
+fn past_the_budget_no_time_is_left() {
+    let bed = afk_bed();
+    bed.clock.advance(Duration::from_secs(3 * 3600));
+    let afk = status_of(&bed).afk.unwrap();
+    assert_eq!(afk.seconds_left, 0);
+    assert!(afk.spent);
+}
+
+#[test]
+fn the_json_form_carries_the_same_field_names() {
+    let json = serde_json::to_value(status_of(&afk_bed())).unwrap();
+    let afk = json.get("afk").unwrap();
+    for key in ["budget_ends_at", "seconds_left", "spent", "decisions"] {
+        assert!(afk.get(key).is_some(), "{key} missing from {afk}");
+    }
+}
