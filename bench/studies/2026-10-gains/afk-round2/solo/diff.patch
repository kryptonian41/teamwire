@@ -0,0 +1,120 @@
+//! Close of an AFK run's team: refused until `afk/REPORT.md` has every
+//! heading of the AFK skill. A member removal and an ordinary team are
+//! unaffected.
+
+#![expect(
+    clippy::unwrap_used,
+    reason = "a failing unwrap in an integration test fails the test"
+)]
+
+#[path = "support/rig.rs"]
+pub mod rig;
+
+use rig::Rig;
+use teamwire_close::{AFK_REPORT_HEADINGS, CloseOpts, CloseTarget, close, plan_close};
+use teamwire_core::{MemberKind, Role, TeamState};
+
+fn afk_rig() -> Rig {
+    let mut rig = Rig::without_repo();
+    rig.store
+        .write(|tx| {
+            tx.connection()
+                .execute(
+                    "UPDATE team SET afk_budget_ends_at = '2026-10-20T08:00:00Z'",
+                    [],
+                )
+                .map(|_| ())
+                .map_err(Into::into)
+        })
+        .unwrap();
+    rig.add_pane_member("scout", MemberKind::Investigator);
+    rig
+}
+
+fn full_report() -> String {
+    AFK_REPORT_HEADINGS
+        .iter()
+        .enumerate()
+        .map(|(i, h)| format!("## {}. {h}\n\ntext\n\n", i + 1))
+        .collect::<Vec<_>>()
+        .concat()
+}
+
+fn incomplete(refusals: &[String]) -> bool {
+    refusals
+        .iter()
+        .any(|r| r.starts_with("refused: afk_report_incomplete: "))
+}
+
+#[test]
+fn a_missing_report_refuses_the_close() {
+    let mut rig = afk_rig();
+    let plan = plan_close(&rig.ctx(), CloseTarget::Team);
+    assert!(incomplete(&plan.refusals), "{:?}", plan.refusals);
+    assert!(asks(&plan.refusals, "is missing"));
+    let report = close(&mut rig.ctx(), CloseTarget::Team, CloseOpts::default());
+    assert!(incomplete(&report.refusals), "{report:?}");
+    assert_eq!(rig.team().state, TeamState::Open);
+}
+
+#[test]
+fn a_report_without_a_heading_names_it() {
+    let rig = afk_rig();
+    rig.team_file(
+        "afk/REPORT.md",
+        &full_report().replace("## 7. Risks", "Risks"),
+    );
+    let mut rig = rig;
+    let plan = plan_close(&rig.ctx(), CloseTarget::Team);
+    assert!(incomplete(&plan.refusals), "{:?}", plan.refusals);
+    assert!(asks(&plan.refusals, "lacks the heading(s): Risks"));
+}
+
+#[test]
+fn a_complete_report_lets_the_close_run_and_reaches_the_archive() {
+    let mut rig = afk_rig();
+    rig.team_file("afk/REPORT.md", &full_report());
+    let plan = plan_close(&rig.ctx(), CloseTarget::Team);
+    assert!(plan.refusals.is_empty(), "{:?}", plan.refusals);
+    let report = close(&mut rig.ctx(), CloseTarget::Team, CloseOpts::default());
+    assert!(report.refusals.is_empty(), "{report:?}");
+    let archive = report.archive.unwrap();
+    assert!(archive.join("afk").join("REPORT.md").is_file());
+}
+
+#[test]
+fn bold_and_plain_headings_both_count() {
+    let mut rig = afk_rig();
+    let text: String = AFK_REPORT_HEADINGS
+        .iter()
+        .map(|h| format!("# **{h}**\n"))
+        .collect::<Vec<_>>()
+        .concat();
+    rig.team_file("afk/REPORT.md", &text);
+    assert!(
+        plan_close(&rig.ctx(), CloseTarget::Team)
+            .refusals
+            .is_empty()
+    );
+}
+
+#[test]
+fn removing_a_member_needs_no_report() {
+    let mut rig = afk_rig();
+    let role = Role::parse("scout").unwrap();
+    let plan = plan_close(&rig.ctx(), CloseTarget::Member(role));
+    assert!(!incomplete(&plan.refusals), "{:?}", plan.refusals);
+}
+
+#[test]
+fn an_ordinary_team_needs_no_report() {
+    let mut rig = Rig::without_repo();
+    rig.add_pane_member("scout", MemberKind::Investigator);
+    assert!(!incomplete(
+        &plan_close(&rig.ctx(), CloseTarget::Team).refusals
+    ));
+}
+
+fn asks(reasons: &[String], word: &str) -> bool {
+    reasons.iter().any(|r| r.contains(word))
+}
