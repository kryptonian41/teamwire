@@ -0,0 +1,50 @@
+//! The report an AFK run must leave before its team closes (ADR 0025).
+
+use std::path::Path;
+
+/// The headings of `afk/REPORT.md`, as the AFK skill lists them.
+pub const AFK_REPORT_HEADINGS: [&str; 8] = [
+    "What you asked",
+    "What I understood",
+    "The result",
+    "Verified",
+    "Decisions made for you",
+    "Not done, and why",
+    "Risks",
+    "Cost",
+];
+
+/// Why the team's `afk/REPORT.md` cannot close the run, or `None` when the
+/// report exists with every heading. A heading is a Markdown heading line
+/// whose text starts with one of `AFK_REPORT_HEADINGS`, ignoring case, a
+/// leading number and emphasis marks.
+pub(crate) fn report_refusal(team_dir: &Path) -> Option<String> {
+    let path = team_dir.join("afk").join("REPORT.md");
+    let Ok(text) = std::fs::read_to_string(&path) else {
+        return Some(format!(
+            "refused: afk_report_incomplete: {} is missing; have the reporter write it",
+            path.display()
+        ));
+    };
+    let headings: Vec<String> = text
+        .lines()
+        .filter_map(|line| line.trim_start().strip_prefix('#'))
+        .map(|h| {
+            h.trim_start_matches('#')
+                .trim_start_matches(|c: char| c.is_ascii_digit() || " .*_".contains(c))
+                .to_lowercase()
+        })
+        .collect();
+    let missing: Vec<&str> = AFK_REPORT_HEADINGS
+        .into_iter()
+        .filter(|want| !headings.iter().any(|h| h.starts_with(&want.to_lowercase())))
+        .collect();
+    if missing.is_empty() {
+        return None;
+    }
+    Some(format!(
+        "refused: afk_report_incomplete: {} lacks the heading(s): {}",
+        path.display(),
+        missing.join("; ")
+    ))
+}
