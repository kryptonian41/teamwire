+    let ends = teamwire_core::Timestamp::from_unix_millis(
+        teamwire_platform::SystemClock.now().unix_millis() + hours * 3_600_000,
+    )
+    .unwrap();
+    fx.store
+        .write(|tx| {
+            tx.adopt_lead(
+                at,
+                &SessionId::parse("lead-1").unwrap(),
+                SessionKind::Interactive,
+            )?;
+            tx.connection()
+                .execute(
+                    "UPDATE team SET afk_budget_ends_at = ?1",
+                    [ends.to_string()],
+                )
+                .map(|_| ())
+                .map_err(Into::into)
+        })
+        .unwrap();
+    fx
+}
+
