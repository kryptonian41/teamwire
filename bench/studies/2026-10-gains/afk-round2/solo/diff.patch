@@ -0,0 +1,162 @@
+//! `teamwire afk start`: create an AFK run's team with no members, copy its
+//! task, and take the sleep hold at once (ADR 0025).
+
+use std::path::PathBuf;
+use std::process::ExitCode;
+use std::time::Duration;
+
+use teamwire_core::{Clock, Config};
+use teamwire_launch::{
+    AfkRequest, SpecError, ValidateEnv, check_lead_process, start_afk, validate_afk,
+};
+use teamwire_store::{Ctx, Store};
+
+use crate::cmd::doctor::{Level, launch_checks};
+use crate::cmd::metrics::parse_duration;
+use crate::cmd::send::{home_or_refuse, refuse_member};
+use crate::wiring::Wiring;
+use crate::{AfkArgs, AfkCommand, Global};
+
+/// Exit codes of `docs/api/cli.md`.
+const REFUSED: u8 = 1;
+const STORE_ERROR: u8 = 6;
+
+const COMMAND: &str = "afk start";
+
+pub(crate) fn run(args: &AfkArgs, global: &Global, wiring: &Wiring) -> ExitCode {
+    let AfkCommand::Start {
+        team,
+        title,
+        task,
+        budget,
+    } = &args.action;
+    if let Some(code) = refuse_member(COMMAND) {
+        return code;
+    }
+    let home = match home_or_refuse(COMMAND, global) {
+        Ok(home) => home,
+        Err(code) => return code,
+    };
+    let budget = match parse_duration(budget) {
+        Ok(b) if b > Duration::ZERO => b,
+        Ok(_) => return refuse(&["bad_budget: the budget must be longer than zero".to_owned()]),
+        Err(e) => return refuse(&[format!("bad_budget: {e}")]),
+    };
+    let task = match std::fs::read(task) {
+        Ok(bytes) => bytes,
+        Err(e) => {
+            return refuse(&[format!(
+                "task_unreadable: cannot read the task file {}: {e}",
+                task.display()
+            )]);
+        }
+    };
+    let config = Config::default();
+    let env = ValidateEnv {
+        home: &home,
+        registry: &wiring.registry,
+        platform: &*wiring.platform,
+        clock: &wiring.clock,
+        config: &config,
+        lead_harness: wiring.lead_harness.clone(),
+        lead_host: wiring.lead_host.clone(),
+        user_home: std::env::var_os("HOME").map(PathBuf::from),
+        teamwire_bin: std::env::current_exe().unwrap_or_else(|_| PathBuf::from("teamwire")),
+    };
+    let request = AfkRequest {
+        team: team.clone(),
+        title: title.clone(),
+        budget,
+    };
+    let plan = match validate_afk(&request, &env) {
+        Ok(plan) => plan,
+        Err(errors) => return refuse(&lines(&errors)),
+    };
+    let checks = match launch_checks(COMMAND, global, wiring) {
+        Ok(checks) => checks,
+        Err(code) => return code,
+    };
+    let failed: Vec<String> = checks
+        .iter()
+        .filter(|c| c.level == Level::Fail)
+        .map(|c| format!("doctor_failed: {}: {}", c.name, c.detail))
+        .collect();
+    if !failed.is_empty() {
+        return refuse(&failed);
+    }
+    for c in checks.iter().filter(|c| c.level == Level::Warn) {
+        warn(&format!("warning: {}: {}", c.name, c.detail));
+    }
+    if let Err(e) = check_lead_process(&env, &plan) {
+        return refuse(&lines(&[e]));
+    }
+    let mut store = match Store::open(&home, &plan.team) {
+        Ok(store) => store,
+        Err(e) => {
+            warn(&format!(
+                "teamwire {COMMAND}: the store could not be opened: {e}"
+            ));
+            return ExitCode::from(STORE_ERROR);
+        }
+    };
+    let started = {
+        let mut ctx = Ctx {
+            home: &home,
+            store: &mut store,
+            registry: &wiring.registry,
+            platform: &*wiring.platform,
+            clock: &wiring.clock as &dyn Clock,
+            config: &config,
+        };
+        start_afk(&mut ctx, &plan, &task)
+    };
+    let started = match started {
+        Ok(started) => started,
+        Err(e) => {
+            warn(&format!("teamwire {COMMAND}: {e}"));
+            return ExitCode::from(STORE_ERROR);
+        }
+    };
+    for w in &started.warnings {
+        warn(&format!("warning: {w}"));
+    }
+    let dir = started.afk_dir.display();
+    say(&format!(
+        "team: {}\nafk dir: {dir}\nreport: {dir}/REPORT.md\nbudget ends: {}\n\
+         Keep the lid open and the machine on power: a closed lid still sleeps a Mac.\n\
+         Add members with `teamwire launch --add --spec <file>`; the run is this one team.\n",
+        plan.team, plan.budget_ends_at
+    ));
+    ExitCode::SUCCESS
+}
+
+fn lines(errors: &[SpecError]) -> Vec<String> {
+    errors
+        .iter()
+        .map(|e| format!("{}: {}", e.code, e.message))
+        .collect()
+}
+
+fn refuse(reasons: &[String]) -> ExitCode {
+    for why in reasons {
+        warn(&format!("refused: {why}"));
+    }
+    warn("nothing was created");
+    ExitCode::from(REFUSED)
+}
+
+#[expect(
+    clippy::print_stdout,
+    reason = "the start's summary is the command's output"
+)]
+fn say(text: &str) {
+    print!("{text}");
+}
+
+#[expect(
+    clippy::print_stderr,
+    reason = "the binary reports a refusal or a warning on stderr"
+)]
+fn warn(text: &str) {
+    eprintln!("{text}");
+}
